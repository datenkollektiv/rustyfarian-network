/target
Cargo.lock
# ESP-IDF component manager locks (espressif/mqtt), one per chip; a library leaves them to the firmware, like Cargo.lock
components_*.lock
.embuild

.env
.envrc

# secrets (SOPS + age): secrets/ is plaintext and machine-local; shared-secrets/ is SOPS-encrypted
# but stays local too, because this repository is public; so does the SOPS config
secrets/
shared-secrets/
.sops.yaml

.idea/
.claude/
.claudeignore
.codex/
CLAUDE.md
/inbox/
/outbox/
/archive/
/audit/
/release/

# bench run artefacts (rustyfarian-bench): per-run serial logs and results (results record board MACs)
bench/*/logs/
bench/*/results.jsonl

# Tool output captures
.output.txt

# local session hand-off note
continue-here.md

# Temporary script output — use tmp/ for ad-hoc script results
tmp/*
!tmp/.gitkeep

# Local critical-path map (/critical-path), kept off git
docs/critical-path.md
docs/critical-path.json
