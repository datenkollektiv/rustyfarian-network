/target
Cargo.lock
# ESP-IDF component manager locks (espressif/mqtt), one per chip; a library leaves them to the firmware, like Cargo.lock
components_*.lock
.embuild

.env
.envrc

.idea/
.claude/
.claudeignore
.codex/
CLAUDE.md
/inbox/
/outbox/
/archive/
/audit/
/release/

# bench run artefacts (rustyfarian-bench): per-run serial logs and results (results record board MACs)
bench/*/logs/
bench/*/results.jsonl

# Tool output captures
.output.txt

# Temporary script output — use tmp/ for ad-hoc script results
tmp/*
!tmp/.gitkeep
