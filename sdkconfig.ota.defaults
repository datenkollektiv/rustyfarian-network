# OTA overlay for OTA examples, layered on sdkconfig.defaults via ESP_IDF_SDKCONFIG_DEFAULTS
# by scripts/build-example.sh and scripts/flash.sh.
# The absolute CONFIG_PARTITION_TABLE_CUSTOM_FILENAME is generated by those scripts.

# The bootloader rolls back an image that is still pending verification at the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Two OTA slots need the full 4 MB of the C3 boards (the IDF default is 2 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
