# Copy this file to .env and fill in your values.
#
# The justfile loads .env automatically (`set dotenv-load`). Beyond configuring
# the connectivity examples, the NON-SECRET values below also SEED THE
# PROVISIONING PORTAL FORM on a fresh / factory-reset device, so testing the
# captive portal does not mean retyping every field each cycle.
#
# SECURITY: secrets are NEVER pre-filled into the portal HTML and must be typed
# on every submission. `WIFI_PASS`, `MQTT_PASS`, and `LORAWAN_APP_KEY` seed
# nothing in the form — they exist here only for the connectivity/join examples.

# WiFi Configuration
WIFI_SSID=your_wifi_ssid
WIFI_PASS=your_wifi_password
# Wi-Fi country for the ESP-NOW examples (two letters, e.g. DE); unset = 01, the world-safe channels 1-11.
# An ESP-NOW scout must use the country of the network its peer sits on to reach channel 12 or 13.
# WIFI_COUNTRY=DE

# MQTT Configuration (host/port/user/client seed the Wi-Fi+MQTT portal form)
MQTT_HOST=your_mqtt_broker_host
MQTT_PORT=1883
# MQTT username is optional; leave unset for an anonymous broker connection
# MQTT_USER=your_mqtt_username
# MQTT password is a secret and is NEVER pre-filled into the portal form
# MQTT_PASS=your_mqtt_password
# MQTT client ID must not exceed the 23-byte MQTT 3.1.1 maximum
MQTT_CLIENT_ID=your_mqtt_client_id
# Topic prefix for the MQTT LWT examples (hal_*_mqtt_lwt, idf_esp32s3_mqtt_lwt): <prefix>/status, /cmd, /tick.
# On the esp-hal tier MQTT_HOST must be an IPv4 literal (no DNS yet, ADR 019).
# MQTT_TOPIC_PREFIX=rustyfarian/hal-mqtt
# 1 = the S3 LWT examples suspend Wi-Fi for 20 s every 60 s (suspend/resume demo, runbook R3)
# MQTT_SUSPEND_DEMO=1
# 1 = idf_esp32s3_mqtt_lwt registers a measurement on_connect (Step 8c stack measurement, bug 013)
# MQTT_ON_CONNECT_DEMO=1

# Optional OTA update URL (plain http://) — seeds the portal OTA field
# OTA_URL=http://ota.local/firmware.bin

# OTA runtime example: version of this build and the topic prefix (<prefix>/command, <prefix>/status)
# FIRMWARE_VERSION=0.1.0
# OTA_TOPIC_PREFIX=rustyfarian/example/ota

# LoRaWAN OTAA credentials (fill in from TTN/Chirpstack after device registration)
# DevEUI and AppEUI must be MSB-first as shown in TTN Console (example reverses internally).
# DevEUI + AppEUI seed the LoRaWAN portal form (dev_eui / join_eui).
# AppKey stays MSB-first and is a secret — it is NEVER pre-filled into the form.
# LORAWAN_DEV_EUI=0000000000000000
# LORAWAN_APP_EUI=0000000000000000
# LORAWAN_APP_KEY=A14...32F
